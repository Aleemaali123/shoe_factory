PORT=4000
JWT_SECRET=shoe-factory-dev-secret
DATABASE_PATH=data/shop.db

# Order confirmations: both, whatsapp, or sms.
# Leave the Twilio values empty to log the message instead of sending it.
# Desk can still open WhatsApp (wa.me) with a prefilled tracking message.
NOTIFY_CHANNEL=both
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=+1XXXXXXXXXX
TWILIO_WHATSAPP_FROM=whatsapp:+918075090160
ADMIN_WHATSAPP=8075090160

# Public web shop URL — appended as "Track your order: …/orders/{id}" in WhatsApp.
PUBLIC_SHOP_URL=https://shoefactory-shop.web.app

# Razorpay (Dashboard → Test/Live mode → API Keys).
# Key Id is exposed to the Flutter/web apps via GET /api/payments/razorpay.
# Key Secret never leaves this file — used only to create orders and verify payments.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
